# Copy this file to .env.local for local development (npm run dev).
#
# Leave VITE_API_BASE_URL empty (the default) to use relative "/api" calls -
# these are transparently proxied to the backend by Vite's dev server (see
# vite.config.ts `server.proxy`, which reads this same variable) and, in
# production, by Nginx (see nginx.conf.template). This means the browser
# never needs the backend to send CORS headers.
#
# Only set this to a non-empty absolute URL if you specifically want the
# browser to call the backend on a different origin directly (which then
# requires the backend to send appropriate CORS headers itself).
#
# This same variable also tells `npm run dev`'s proxy (vite.config.ts) and
# Nginx's BACKEND_UPSTREAM (see nginx.conf.template / Dockerfile) where the
# real backend lives. Typical local value:
VITE_API_BASE_URL=http://localhost:8080
